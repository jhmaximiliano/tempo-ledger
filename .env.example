# Plantilla de configuración. Copia este archivo como `.env` y ajusta los valores.
# Este archivo SÍ se sube a GitHub: solo dice qué variables existen.
# El `.env` real NO se sube (está en .gitignore).

# --- Reglas del banco de horas ---
# Días que tiene un permiso antes de vencer y descontarse del saldo.
TEMPO_DEBIT_EXPIRY_DAYS=30

# --- Base de datos ---
# SQLite por defecto (un archivo local). PostgreSQL: postgresql+psycopg://usuario:clave@host:5432/tempo
# (requiere el extra: `uv sync --extra postgres`).
TEMPO_DATABASE_URL=sqlite:///tempo.db

# --- Datos ficticios ---
# Misma semilla = mismos empleados y movimientos (útil para pruebas y demos).
TEMPO_SEED=42
TEMPO_EMPLOYEES=60
# La API llena la base con estos datos al arrancar si está vacía. false: no la llena.
TEMPO_AUTO_SEED=true

